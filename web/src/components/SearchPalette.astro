---
---

<dialog
  id="search-palette"
  class="rounded-xl border border-stone-700 bg-[#1f1f1f] text-stone-100 p-0 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm w-full max-w-xl mt-[15vh] mx-auto"
>
  <div class="flex items-center gap-3 border-b border-stone-800 px-4 py-3">
    <svg class="h-4 w-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id="search-input"
      type="text"
      placeholder="Search by name…"
      class="flex-1 border-0 bg-transparent text-sm text-stone-100 placeholder-stone-500 focus:outline-none focus:ring-0"
      autocomplete="off"
    />
    <span id="search-mode-tag" class="hidden rounded bg-amber-900/40 px-2 py-0.5 text-xs font-medium text-amber-200 ring-1 ring-amber-700/40">
      Find yourself
    </span>
    <kbd class="rounded border border-stone-700 bg-stone-800 px-1.5 py-0.5 text-xs font-mono text-stone-400">esc</kbd>
  </div>
  <ul id="search-results" class="max-h-[50vh] overflow-y-auto p-2">
    <li class="px-3 py-2 text-sm text-stone-500">Start typing to search…</li>
  </ul>
</dialog>

<script>
  type Hit = { id: string; n: string; c: string; l: string };
  // Precomputed lowercase fields per hit so the hot loop doesn't redo
  // toLowerCase() / split() on every keystroke.
  type PreparedHit = { hit: Hit; n: string; words: string[]; c: string };

  let prepared: PreparedHit[] | null = null;
  let loadingPromise: Promise<PreparedHit[]> | null = null;

  async function loadIndex() {
    if (prepared) return prepared;
    if (!loadingPromise) {
      loadingPromise = fetch('/data/search.json')
        .then(r => r.json())
        .then((json: Hit[]) => {
          // Prepare normalized fields once at load time.
          prepared = json.map(hit => ({
            hit,
            n: hit.n.toLowerCase(),
            words: hit.n.toLowerCase().split(/\s+/),
            c: hit.c.toLowerCase(),
          }));
          return prepared;
        });
    }
    return loadingPromise;
  }

  function search(q: string): Hit[] {
    if (!prepared) return [];
    const lower = q.toLowerCase().trim();
    if (!lower) return [];
    const scored: Array<[number, Hit]> = [];
    for (let i = 0; i < prepared.length; i++) {
      const p = prepared[i];
      let s = 0;
      if (p.n === lower) s = 100;
      else if (p.n.startsWith(lower)) s = 80;
      else if (p.words.some(w => w.startsWith(lower))) s = 60;
      else if (p.c.includes(lower)) s = 50;
      else if (p.n.includes(lower)) s = 30;
      if (s > 0) scored.push([s, p.hit]);
    }
    scored.sort((a, b) => b[0] - a[0]);
    return scored.slice(0, 30).map(([, h]) => h);
  }

  function render(hits: Hit[], q: string) {
    const ul = document.getElementById('search-results');
    if (!ul) return;
    if (!q) {
      ul.innerHTML = '<li class="px-3 py-2 text-sm text-stone-500">Start typing to search…</li>';
      return;
    }
    if (hits.length === 0) {
      ul.innerHTML = `<li class="px-3 py-2 text-sm text-stone-500">No matches for “${q}”.</li>`;
      return;
    }
    ul.innerHTML = hits.map((h, i) => `
      <li>
        <button
          type="button"
          data-id="${h.id}"
          data-index="${i}"
          class="hit-row group flex w-full items-center justify-between gap-3 rounded-md px-3 py-2 text-left text-sm hover:bg-stone-800 aria-selected:bg-stone-800"
        >
          <span class="truncate font-medium text-stone-100 group-hover:text-amber-300">${h.n}</span>
          <span class="flex shrink-0 items-center gap-2 text-xs text-stone-400">
            ${h.l ? `<span>${h.l}</span>` : ''}
            ${h.c ? `<span class="rounded bg-stone-800 px-1.5 py-0.5 font-mono">${h.c}</span>` : ''}
          </span>
        </button>
      </li>
    `).join('');
    Array.from(ul.querySelectorAll<HTMLButtonElement>('.hit-row')).forEach(btn =>
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        if (id) selectResult(id);
      })
    );
    selected = 0;
    updateSelected();
  }

  let selected = 0;
  function updateSelected() {
    document.querySelectorAll('.hit-row').forEach((el, i) =>
      el.setAttribute('aria-selected', i === selected ? 'true' : 'false')
    );
    document.querySelector('.hit-row[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' });
  }

  // Mode determines what selecting a result does:
  //   'open' (default) — opens the person modal (existing behavior)
  //   'self'           — sets that person as the visitor's "you" marker
  // The mode is carried on the openPalette call rather than a global flag
  // so a forgotten reset can't leak between unrelated opens.
  type Mode = 'open' | 'self';
  let currentMode: Mode = 'open';

  function selectResult(id: string) {
    const modal = document.getElementById('search-palette') as HTMLDialogElement;
    modal?.close();
    if (currentMode === 'self') {
      const ft = (window as any).__familytree;
      ft?.setSelf?.(id);
      // Land on the picked person — same intent as a regular search hit.
      // Modal's "This is me" doesn't focus because the user is already
      // looking at that card, but reaching "Find me" via search means
      // they expect a recenter.
      ft?.focusOn?.(id);
    } else {
      window.dispatchEvent(new CustomEvent('familytree:open-person', { detail: { id } }));
    }
  }

  function openPalette(mode: Mode = 'open') {
    const modal = document.getElementById('search-palette') as HTMLDialogElement;
    const input = document.getElementById('search-input') as HTMLInputElement;
    if (!modal || !input) return;
    currentMode = mode;
    const tag = document.getElementById('search-mode-tag');
    if (tag) tag.classList.toggle('hidden', mode !== 'self');
    input.placeholder = mode === 'self'
      ? 'Search for your name…'
      : 'Search by name…';
    loadIndex();
    modal.showModal();
    input.value = '';
    input.focus();
    render([], '');
  }

  document.getElementById('search-trigger')?.addEventListener('click', () => openPalette('open'));

  // Cross-component open. TopBar's "Find me" prompt dispatches this with
  // mode: 'self' to launch the palette in self-marker mode.
  document.addEventListener('familytree:open-search', (e: any) => {
    openPalette(e.detail?.mode || 'open');
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openPalette('open');
    }
  });

  // Debounce search to one animation frame. Coalesces fast typing into a
  // single render per frame (~16ms) instead of one render per keystroke.
  let searchPending = 0;
  let lastQuery = '';
  document.getElementById('search-input')?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value;
    lastQuery = q;
    if (searchPending) return;
    searchPending = requestAnimationFrame(async () => {
      searchPending = 0;
      const idx = await loadIndex();
      if (!idx.length) return;
      const hits = search(lastQuery);
      render(hits, lastQuery);
    });
  });

  document.getElementById('search-input')?.addEventListener('keydown', (e) => {
    const rows = document.querySelectorAll('.hit-row');
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (rows.length) selected = Math.min(rows.length - 1, selected + 1);
      updateSelected();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (rows.length) selected = Math.max(0, selected - 1);
      updateSelected();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const row = rows[selected] as HTMLElement | undefined;
      const id = row?.dataset.id;
      if (id) selectResult(id);
    }
  });

  document.getElementById('search-palette')?.addEventListener('click', (e) => {
    const dialog = e.currentTarget as HTMLDialogElement;
    const rect = dialog.getBoundingClientRect();
    const inside = rect.top <= e.clientY && e.clientY <= rect.top + rect.height
      && rect.left <= e.clientX && e.clientX <= rect.left + rect.width;
    if (!inside) dialog.close();
  });
</script>
