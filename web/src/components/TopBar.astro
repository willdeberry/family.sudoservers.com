---
---

<header class="z-10 flex h-14 items-center gap-4 border-b border-stone-800 bg-[#171717] px-4">
  <div class="flex items-center gap-2">
    <div
      class="grid h-8 w-8 place-items-center rounded-lg bg-amber-700 text-amber-50 shadow-inner"
      aria-hidden="true"
    >
      <!-- Tiered pine-tree silhouette in a single fill. Reads cleanly
           at this size and stays generic now that the title isn't
           surname-bound. -->
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L6 10H8L4 16H10V20H14V16H20L16 10H18L12 2Z" />
      </svg>
    </div>
    <h1 class="hidden whitespace-nowrap text-lg font-semibold tracking-tight text-stone-100 sm:inline">
      Family Tree
    </h1>
  </div>

  <div class="flex-1"></div>

  <button
    id="nav-back"
    type="button"
    disabled
    title="Back (Backspace)"
    class="hidden items-center gap-1.5 rounded-md border border-stone-700 bg-stone-800 px-2.5 py-1.5 text-sm text-stone-400 hover:border-stone-600 hover:bg-stone-700 hover:text-stone-200 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-stone-800 disabled:hover:text-stone-400 sm:flex"
  >
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    <span>Back</span>
  </button>

  <button
    id="search-trigger"
    type="button"
    class="group flex items-center gap-2 rounded-md border border-stone-700 bg-stone-800 px-3 py-1.5 text-sm text-stone-400 hover:border-stone-600 hover:bg-stone-700 hover:text-stone-200"
  >
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span class="hidden sm:inline">Search anyone…</span>
    <kbd class="hidden rounded border border-stone-600 bg-stone-900 px-1.5 py-0.5 text-xs font-mono text-stone-400 sm:inline-block">
      ⌘K
    </kbd>
  </button>

  <!-- `style="display:none"` hides at every breakpoint until familytree:ready
       fires; we drop the inline style then so the responsive
       `hidden md:block` classes take over (hidden below md, block above). -->
  <div id="stats-pill" class="hidden text-xs text-stone-400 md:block" style="display:none">
    <span id="stat-total">…</span>
  </div>

  <!-- Self slot — one of two states lives here:
         • #self-prompt: shown when no self is marked.  Clicking it
           opens the search palette in "find yourself" mode.
         • #self-pill: shown when self is marked.  Name area focuses
           the tree; × clears the mark.
       KinshipPlugin uses the marked self to label every other card
       with its relationship. -->
  <button
    id="self-prompt"
    type="button"
    title="Find yourself in the tree to see how everyone's related"
    class="hidden cursor-pointer items-center gap-2 rounded-md border border-dashed border-amber-700/40 bg-transparent px-2.5 py-1.5 text-sm text-amber-200/80 hover:border-amber-600/70 hover:bg-amber-900/20 hover:text-amber-100 sm:flex"
  >
    <svg class="h-4 w-4 text-amber-300/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" />
      <circle cx="9" cy="7" r="4" stroke-linecap="round" stroke-linejoin="round" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M20 8v6M23 11h-6" />
    </svg>
    <span>Find me</span>
  </button>
  <div
    id="self-pill"
    style="display:none"
    class="hidden items-center gap-px rounded-md border border-amber-700/50 bg-amber-900/30 text-sm text-amber-100 sm:flex"
  >
    <button
      id="self-pill-focus"
      type="button"
      title="Focus tree on you"
      class="flex cursor-pointer items-center gap-2 rounded-l-md px-2.5 py-1.5 hover:bg-amber-900/40"
    >
      <span class="text-xs text-amber-300/70">You:</span>
      <span id="self-pill-name" class="max-w-[140px] truncate"></span>
    </button>
    <button
      id="self-pill-clear"
      type="button"
      title="Clear who you are"
      aria-label="Clear self-marker"
      class="grid cursor-pointer place-items-center rounded-r-md px-2 py-1.5 text-amber-300/70 hover:bg-amber-900/50 hover:text-amber-100"
    >
      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <!-- Auth pill. The GIS button renders inside #auth-signin-host when
       signed out; #auth-user shows name + sign-out when signed in. The
       GIS DOM API mounts only on data-rendered elements, so we ship a
       g_id_signin div here and let the loader do its thing once the
       GSI script lands. -->
  <div id="auth-signin-host" class="hidden h-9 items-center sm:flex">
    <div class="g_id_signin"
      data-type="standard"
      data-theme="filled_black"
      data-size="medium"
      data-text="signin_with"
      data-shape="pill"></div>
  </div>
  <div id="auth-user" class="hidden items-center gap-2 rounded-md border border-stone-700 bg-stone-800 px-2.5 py-1.5 text-sm sm:flex">
    <img id="auth-user-pic" class="hidden h-5 w-5 rounded-full" alt="" />
    <span id="auth-user-name" class="max-w-[160px] truncate text-stone-200"></span>
    <button id="auth-signout" type="button" class="text-xs text-stone-400 hover:text-stone-200 underline">
      Sign out
    </button>
  </div>
</header>

<script>
  document.addEventListener('familytree:ready', (e: any) => {
    const { total } = e.detail;
    const elTotal = document.getElementById('stat-total');
    if (elTotal) elTotal.textContent = `${total.toLocaleString()} people`;
    // Stats pill stays hidden until `familytree:ready` fires; once data
    // is loaded, opt back into the markup-default `hidden md:block`
    // (which keeps it hidden below the md breakpoint on mobile).
    document.getElementById('stats-pill')?.style.removeProperty('display');
  });

  const backBtn = document.getElementById('nav-back') as HTMLButtonElement | null;
  backBtn?.addEventListener('click', () => (window as any).__familytree?.back());
  document.addEventListener('familytree:nav', (e: any) => {
    if (!backBtn) return;
    backBtn.disabled = !e.detail.canGoBack;
  });

  const signinHost = document.getElementById('auth-signin-host');
  const userPill = document.getElementById('auth-user');
  const userName = document.getElementById('auth-user-name');
  const userPic = document.getElementById('auth-user-pic') as HTMLImageElement | null;
  function renderAuth(u: any) {
    const signedIn = !!u;
    // Drive visibility via inline style only — leave the responsive
    // `hidden ... sm:flex` Tailwind classes alone so each pill is still
    // hidden below the sm breakpoint regardless of auth state. (Mobile
    // users sign in through the suggestion modal's GIS button, so
    // they're never blocked.)
    if (signinHost) signinHost.style.display = signedIn ? 'none' : '';
    if (userPill) userPill.style.display = signedIn ? '' : 'none';
    if (signedIn) {
      if (userName) userName.textContent = u.name || u.email || 'Signed in';
      if (userPic) {
        if (u.picture) {
          userPic.src = u.picture;
          userPic.classList.remove('hidden');
        } else {
          userPic.classList.add('hidden');
        }
      }
    }
  }
  // Pick up state in case auth was restored before this script ran.
  renderAuth((window as any).__auth?.getUser?.());
  document.addEventListener('auth:change', (e: any) => renderAuth(e.detail.user));
  document.getElementById('auth-signout')?.addEventListener('click', () => {
    (window as any).__auth?.signOut?.();
  });

  // Self slot — toggles between the "Find me" prompt and the
  // "You: <Name>" pill based on whether a self id is marked.
  const selfPill = document.getElementById('self-pill');
  const selfPillName = document.getElementById('self-pill-name');
  const selfPrompt = document.getElementById('self-prompt');
  function renderSelf(self: { id: string; displayName: string | null } | null) {
    if (!selfPill || !selfPillName || !selfPrompt) return;
    if (self?.displayName) {
      selfPill.style.removeProperty('display');
      selfPillName.textContent = self.displayName;
      selfPrompt.style.display = 'none';
    } else {
      selfPill.style.display = 'none';
      selfPrompt.style.removeProperty('display');
    }
  }
  // Pick up the persisted choice once the chart bootstrap exposes
  // __familytree. The chart fires familytree:self-change immediately
  // after seeding from localStorage on load, but if this script runs
  // first we miss that — so also poll once via getSelf() when nav
  // events arrive (the first one fires right after the initial render).
  document.addEventListener('familytree:self-change', (e: any) => renderSelf(e.detail));
  document.addEventListener('familytree:nav', () => {
    if (selfPill?.style.display === 'none') {
      const ft = (window as any).__familytree;
      const self = ft?.getSelf?.();
      if (self) renderSelf(self);
    }
  });
  document.getElementById('self-pill-focus')?.addEventListener('click', () => {
    const ft = (window as any).__familytree;
    const self = ft?.getSelf?.();
    if (self?.id) ft?.focusOn?.(self.id);
  });
  document.getElementById('self-pill-clear')?.addEventListener('click', () => {
    (window as any).__familytree?.clearSelf?.();
  });
  document.getElementById('self-prompt')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('familytree:open-search', {
      detail: { mode: 'self' },
    }));
  });

  // Pick the right initial state before the chart bootstrap fires its
  // self-change event.  Reading localStorage directly avoids the brief
  // flash of "Find me" when the visitor has already marked themselves.
  try {
    const seed = localStorage.getItem('ft:self-id');
    if (!seed) renderSelf(null);
    // If a self id is persisted, leave both elements hidden; the chart
    // bootstrap will fire familytree:self-change with the display name
    // once the data is loaded.
  } catch {
    renderSelf(null);
  }
</script>
