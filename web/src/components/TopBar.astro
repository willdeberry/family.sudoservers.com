---
---

<header class="z-10 flex h-14 items-center gap-4 border-b border-stone-800 bg-[#171717] px-4">
  <div class="flex items-center gap-2">
    <div
      class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-amber-500 to-amber-700 text-sm font-bold text-amber-50 shadow-inner"
    >
      G
    </div>
    <h1 class="hidden whitespace-nowrap text-lg font-semibold tracking-tight text-stone-100 sm:inline">
      Guthrie Family Tree
    </h1>
  </div>

  <div class="flex-1"></div>

  <button
    id="nav-back"
    type="button"
    disabled
    title="Back (Backspace)"
    class="hidden items-center gap-1.5 rounded-md border border-stone-700 bg-stone-800 px-2.5 py-1.5 text-sm text-stone-400 hover:border-stone-600 hover:bg-stone-700 hover:text-stone-200 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-stone-800 disabled:hover:text-stone-400 sm:flex"
  >
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    <span>Back</span>
  </button>

  <button
    id="search-trigger"
    type="button"
    class="group flex items-center gap-2 rounded-md border border-stone-700 bg-stone-800 px-3 py-1.5 text-sm text-stone-400 hover:border-stone-600 hover:bg-stone-700 hover:text-stone-200"
  >
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span class="hidden sm:inline">Search anyone…</span>
    <kbd class="hidden rounded border border-stone-600 bg-stone-900 px-1.5 py-0.5 text-xs font-mono text-stone-400 sm:inline-block">
      ⌘K
    </kbd>
  </button>

  <!-- `style="display:none"` hides at every breakpoint until familytree:ready
       fires; we drop the inline style then so the responsive
       `hidden md:block` classes take over (hidden below md, block above). -->
  <div id="stats-pill" class="hidden text-xs text-stone-400 md:block" style="display:none">
    <span id="stat-total">…</span>
    <span class="ml-1.5 text-stone-600">·</span>
    <span class="ml-1.5"><span id="stat-verified">…</span> verified</span>
  </div>

  <!-- Auth pill. The GIS button renders inside #auth-signin-host when
       signed out; #auth-user shows name + sign-out when signed in. The
       GIS DOM API mounts only on data-rendered elements, so we ship a
       g_id_signin div here and let the loader do its thing once the
       GSI script lands. -->
  <div id="auth-signin-host" class="hidden h-9 items-center sm:flex">
    <div class="g_id_signin"
      data-type="standard"
      data-theme="filled_black"
      data-size="medium"
      data-text="signin_with"
      data-shape="pill"></div>
  </div>
  <div id="auth-user" class="hidden items-center gap-2 rounded-md border border-stone-700 bg-stone-800 px-2.5 py-1.5 text-sm sm:flex">
    <img id="auth-user-pic" class="hidden h-5 w-5 rounded-full" alt="" />
    <span id="auth-user-name" class="max-w-[160px] truncate text-stone-200"></span>
    <button id="auth-signout" type="button" class="text-xs text-stone-400 hover:text-stone-200 underline">
      Sign out
    </button>
  </div>
</header>

<script>
  document.addEventListener('familytree:ready', (e: any) => {
    const { total, verified } = e.detail;
    const elTotal = document.getElementById('stat-total');
    const elVerified = document.getElementById('stat-verified');
    if (elTotal) elTotal.textContent = `${total.toLocaleString()} people`;
    if (elVerified) elVerified.textContent = `${verified}`;
    // Stats pill stays hidden until `familytree:ready` fires; once data
    // is loaded, opt back into the markup-default `hidden md:block`
    // (which keeps it hidden below the md breakpoint on mobile).
    document.getElementById('stats-pill')?.style.removeProperty('display');
  });

  const backBtn = document.getElementById('nav-back') as HTMLButtonElement | null;
  backBtn?.addEventListener('click', () => (window as any).__familytree?.back());
  document.addEventListener('familytree:nav', (e: any) => {
    if (!backBtn) return;
    backBtn.disabled = !e.detail.canGoBack;
  });

  const signinHost = document.getElementById('auth-signin-host');
  const userPill = document.getElementById('auth-user');
  const userName = document.getElementById('auth-user-name');
  const userPic = document.getElementById('auth-user-pic') as HTMLImageElement | null;
  function renderAuth(u: any) {
    const signedIn = !!u;
    // Drive visibility via inline style only — leave the responsive
    // `hidden ... sm:flex` Tailwind classes alone so each pill is still
    // hidden below the sm breakpoint regardless of auth state. (Mobile
    // users sign in through the suggestion modal's GIS button, so
    // they're never blocked.)
    if (signinHost) signinHost.style.display = signedIn ? 'none' : '';
    if (userPill) userPill.style.display = signedIn ? '' : 'none';
    if (signedIn) {
      if (userName) userName.textContent = u.name || u.email || 'Signed in';
      if (userPic) {
        if (u.picture) {
          userPic.src = u.picture;
          userPic.classList.remove('hidden');
        } else {
          userPic.classList.add('hidden');
        }
      }
    }
  }
  // Pick up state in case auth was restored before this script ran.
  renderAuth((window as any).__auth?.getUser?.());
  document.addEventListener('auth:change', (e: any) => renderAuth(e.detail.user));
  document.getElementById('auth-signout')?.addEventListener('click', () => {
    (window as any).__auth?.signOut?.();
  });
</script>
