---
---

<header class="z-10 flex h-14 items-center gap-4 border-b border-stone-200 bg-white px-4 shadow-sm">
  <div class="flex items-center gap-2">
    <div
      class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-amber-700 to-amber-900 text-sm font-bold text-amber-50 shadow-inner"
    >
      G
    </div>
    <h1 class="text-lg font-semibold tracking-tight text-stone-900">
      Guthrie Family Tree
    </h1>
  </div>

  <div class="flex-1"></div>

  <button
    id="search-trigger"
    type="button"
    class="group flex items-center gap-2 rounded-md border border-stone-300 bg-stone-50 px-3 py-1.5 text-sm text-stone-500 hover:border-stone-400 hover:bg-white"
  >
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <span class="hidden sm:inline">Search anyone…</span>
    <kbd class="hidden rounded border border-stone-300 bg-white px-1.5 py-0.5 text-xs font-mono text-stone-500 sm:inline-block">
      ⌘K
    </kbd>
  </button>

  <div id="stats-pill" class="hidden text-xs text-stone-500 md:block">
    <span id="stat-total">…</span>
    <span class="ml-1.5 text-stone-400">·</span>
    <span class="ml-1.5"><span id="stat-verified">…</span> verified</span>
  </div>
</header>

<script>
  // Populate stats once the data is loaded by Tree.
  document.addEventListener('familytree:ready', (e: any) => {
    const { total, verified } = e.detail;
    const elTotal = document.getElementById('stat-total');
    const elVerified = document.getElementById('stat-verified');
    if (elTotal) elTotal.textContent = `${total.toLocaleString()} people`;
    if (elVerified) elVerified.textContent = `${verified}`;
    document.getElementById('stats-pill')?.classList.remove('hidden');
  });
</script>
