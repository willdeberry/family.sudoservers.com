---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

// Compute the people count at build time so the loading text is always
// accurate. Reads the same tree.json the client fetches.
const treePath = resolve(fileURLToPath(import.meta.url), '..', '..', '..', 'public', 'data', 'tree.json');
let peopleCount: string;
try {
  const tree = JSON.parse(readFileSync(treePath, 'utf-8'));
  peopleCount = (tree.meta?.totalPeople ?? tree.people?.length ?? 0).toLocaleString('en-US');
} catch {
  peopleCount = '';
}
---

<!-- The tree mounts into this container -->
<div
  id="family-chart"
  class="f3 absolute inset-0"
  style="--card-radius: 12px;"
>
  <div
    id="family-chart-loading"
    class="grid h-full place-items-center text-stone-500"
  >
    <div class="flex items-center gap-3">
      <svg class="h-5 w-5 animate-spin text-stone-400" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4z"></path>
      </svg>
      <span class="text-sm">Loading {peopleCount} people…</span>
    </div>
  </div>
</div>

<script>
  import * as f3 from 'family-chart-premium';
  import 'family-chart-premium/styles/family-chart.css';

  type Datum = {
    id: string;
    data: Record<string, any>;
    rels: { parents: string[]; spouses: string[]; children: string[] };
  };

  // Lazy-load the full dataset when the user navigates outside the initial
  // slice (founder's 4-hop neighborhood, ~840 nodes).
  let fullDataPromise: Promise<Datum[]> | null = null;
  function loadFullData(): Promise<Datum[]> {
    if (!fullDataPromise) {
      fullDataPromise = fetch('/data/tree-full.json')
        .then(r => r.json())
        .then(p => p.people as Datum[]);
    }
    return fullDataPromise;
  }

  async function bootstrap() {
    performance.mark('chart:fetch-start');
    const res = await fetch('/data/tree.json');
    const payload = await res.json();
    performance.mark('chart:fetch-end');
    // `server-serialization`: counts are precomputed at build time so we
    // don't filter all 4.9k rows on the client just to populate the top bar.
    const { totalPeople, verifiedCount, sliceSize } = payload.meta;
    const data: Datum[] = payload.people;
    console.log(`[chart] initial slice ${sliceSize ?? data.length} of ${totalPeople}`);

    // Default focused person: the founder (always p_000001 — code "0").
    // We don't need to find them since family-chart starts at data[0] by
    // default and the founder is built first in transform-data.mjs.

    const container = document.getElementById('family-chart');
    if (!container) return;

    performance.mark('chart:create-start');
    const chart = f3
      .createChart(container, data as any)
      .setTransitionTime(550)
      .setCardXSpacing(280)
      .setCardYSpacing(160)
      // Asymmetric depth: ancestors fan out modestly (each generation up
      // is bounded — at most 2× parents per child), so a generous depth
      // surfaces the full ancestor chain back to the documented great-
      // great-greats. Descendants fan out aggressively at the top of
      // the tree (John Guthrie's subtree pulls in ~3000 cards at depth
      // 6), so progeny stays at 4 to keep top-of-tree views snappy.
      // Either side can be lifted past these on a per-focus basis via
      // setAncestryDepth/setProgenyDepth — e.g. trace mode bumps
      // ancestry to 50 and zeroes out progeny. Users can also click
      // expand arrows on cards to drill past the default.
      .setAncestryDepth(8)
      .setProgenyDepth(4)
      .setOrientationVertical();
    // FCP replaces setDuplicateBranchToggle with a plugin. Install the
    // duplicate toggle so cousin-marriage cases (a single ancestor reached
    // via two child paths) render a clickable Cn marker instead of being
    // silently duplicated.
    chart.use(new f3.DuplicatesTogglePlugin(
      () => chart.updateTree(),
      () => false, // not horizontal
    ));

    // Sibling row beside the focused person — Ancestry-style.
    chart.setShowSiblingsOfMain();

    // Switch from CardSvg to CardHtml so FullMiniTreePlugin /
    // MiniTreePlugin can measure card dimensions correctly — when fed
    // CardSvg they emit ~30 transform=NaN errors per render. See the
    // FCP combined demo (src/plugins/combined/__demos__/mini-tree-
    // with-full) for the reference setup.
    const CARD_W = 250;
    const CARD_H = 70;
    const card = chart
      .setCardHtml()
      .setCardDisplay([['full name'], ['lifespan']])
      .setCardWidth(CARD_W)
      .setCardHeight(CARD_H)
      // Highlight the path from the hovered card back to the focused
      // person — same Ancestry-style affordance as in the demo. Only
      // exists on CardHtml, which is why we couldn't enable it back on
      // CardSvg.
      .setOnHoverPathToMain();

    card.setCardDim({ width: CARD_W, height: CARD_H });

    // Mini-tree plugins — render embedded sub-trees on cards. The
    // partition (from the FCP combined demo) routes every visible card
    // through one or the other:
    //   • FullMiniTreePlugin draws on cards at the depth limit, so the
    //     user gets a "what's beyond here" preview inline.
    //   • MiniTreePlugin draws on every other card to surface nearby
    //     siblings, spouses, and hidden kids.
    // Clicking any member routes through our focusOn so depth resets,
    // slow-render overlay, and back-nav stack stay consistent.
    function fullMiniTreeFilter(td: any, tree: any, is_ancestry?: boolean): boolean {
      if (!tree?.meta?.max_depth) return false;
      if (td.is_ancestry && tree.meta.max_depth.ancestry === td.depth && is_ancestry) return true;
      if (!td.is_ancestry && tree.meta.max_depth.progeny === td.depth && !is_ancestry) return true;
      return false;
    }
    const onMiniCardClick = (_e: Event, d: any) => {
      const id = d?.data?.id;
      if (id) (window as any).__familytree?.focusOn(id);
    };
    // FullMiniTreePlugin draws an embedded next-generation preview on
    // every card sitting at the visible depth limit. MiniTreePlugin
    // covers everything else — the inverse of the same predicate. Both
    // route clicks through our focusOn so back-nav and slow-render
    // overlay stay consistent.
    //
    // NB: the demo's `add_spacing_for_last_level_*: true` produces
    // ~100 NaN transform errors per render on our data — its In
    // spacing pass hits an undefined member_node_separation and the
    // resulting offsets cascade through the layout. We disable both
    // flags; the mini-trees still render and overlap is minor for
    // our card sizes.
    chart.use(new f3.FullMiniTreePlugin({
      member_card_width: CARD_W,
      member_card_height: CARD_H,
      onCardClick: onMiniCardClick,
      memberCardTooltip: { cont: chart.cont, fullCardRenderer: card.getCard() },
      generateFilter: fullMiniTreeFilter,
      add_spacing_for_last_level_ancestry: false,
      add_spacing_for_last_level_progeny: false,
      align_children_with_member: true,
    }));
    chart.use(new f3.MiniTreePlugin({
      member_card_width: CARD_W,
      member_card_height: CARD_H,
      onCardClick: onMiniCardClick,
      memberCardTooltip: { cont: chart.cont, fullCardRenderer: card.getCard() },
      generateFilter: (td: any, tree: any, is_ancestry?: boolean) =>
        !fullMiniTreeFilter(td, tree, is_ancestry),
    }));
    chart.use(new f3.SpouseBypassLinkPlugin());

    function openPersonModal(id: string) {
      window.dispatchEvent(new CustomEvent('familytree:open-person', { detail: { id } }));
    }

    // Click on the card body — recenter the chart on that person (the
    // Ancestry-style behavior). The "i" info icon (added in
    // setOnCardUpdate below) opens the modal instead; shift- or
    // alt-click on the body is also a modal shortcut for users who
    // already have a hand on the keyboard.
    card.setOnCardClick((e: MouseEvent, d: any) => {
      const id = d.data.id;
      if (e.shiftKey || e.altKey) {
        openPersonModal(id);
        return;
      }
      (window as any).__familytree?.focusOn(id);
    });

    // Info icon injection happens in chart.afterUpdate (see below) —
    // we iterate every card_cont after each layout pass and append a
    // small "i" button that opens the modal.

    // After every update: hide the loader, hide synthetic "to_add"
    // placeholder cards, and inject an info "i" button into the top-
    // right corner of each HTML card. d3's enter/update reuses the
    // existing card_cont so we skip re-injection when the icon is
    // already present.
    chart.setAfterUpdate(() => {
      document.getElementById('family-chart-loading')?.remove();
      const conts = container.querySelectorAll<HTMLElement>('.card_cont');
      conts.forEach(cont => {
        const td: any = (cont as any).__data__;
        const datum = td?.data;
        if (datum?.to_add) {
          cont.style.display = 'none';
          return;
        }
        const id = datum?.id as string | undefined;
        if (!id) return;
        // The visible card is `.card` inside `.card_cont`. `.card_cont`
        // is just a position anchor (translate to chart-coords); the
        // inner `.card` carries the actual top-left of the colored box
        // via translate(-50%, -50%). Attach the icon to `.card` so the
        // CSS `right: 6px / top: 6px` lines up with the visible
        // rectangle instead of the anchor point.
        const cardEl = cont.querySelector<HTMLElement>(':scope > .card');
        if (!cardEl) return;
        if (cardEl.querySelector(':scope > .card-info-icon')) return;
        const btn = document.createElement('div');
        btn.className = 'card-info-icon';
        btn.setAttribute('aria-label', 'Open person details');
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          openPersonModal(id);
        });
        btn.innerHTML = `
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="10" fill="#ffffff"></circle>
            <circle cx="10" cy="6.4" r="1.7" fill="#1f1f1f"></circle>
            <rect x="8.3" y="9.5" width="3.4" height="6.5" rx="0.6" fill="#1f1f1f"></rect>
          </svg>
        `;
        cardEl.appendChild(btn);
      });
    });

    performance.mark('chart:create-end');
    // Initial render — center on the focused person at full scale. Note:
    // family-chart unconditionally calls treeFit when props.initial is
    // truthy, ignoring tree_position. So we pass initial:false explicitly
    // (the entry-animation delay we'd otherwise get isn't worth ~820
    // cards rendering at scale 0.01 and the chart looking invisible).
    performance.mark('chart:render-start');
    // FCP (like the free version) auto-detects "first render" by checking
    // whether any .card_cont elements exist and force-applies fit mode
    // when none do. The fix is to render once (any tree_position is
    // ignored on the first pass), then immediately call updateTree again
    // — now the second call sees the cards and respects main_to_middle.
    chart.updateTree({ tree_position: 'main_to_middle', transition_time: 0 });
    chart.updateTree({ tree_position: 'main_to_middle', transition_time: 0 });
    performance.mark('chart:render-end');

    // Surface where time went in the console so we can profile real loads.
    queueMicrotask(() => {
      const m = (a: string, b: string) =>
        performance.measure(`${a}→${b}`, a, b).duration | 0;
      console.log(
        '[chart timings]',
        'fetch+parse', m('chart:fetch-start', 'chart:fetch-end') + 'ms,',
        'setup', m('chart:create-start', 'chart:create-end') + 'ms,',
        'initial render', m('chart:render-start', 'chart:render-end') + 'ms',
      );
    });

    // Tell the top bar how many people we have
    document.dispatchEvent(
      new CustomEvent('familytree:ready', {
        detail: { total: totalPeople, verified: verifiedCount },
      })
    );

    // Expose a way to focus on a person (used by search + modal).
    // `trace: true` lifts the ancestry depth so you can see the chain all
    // the way back to the founder, and zooms out to fit the whole chain in
    // the viewport. The defaults reset when you focus on someone else.
    const defaultAncestry = 8;
    const defaultProgeny = 4;
    // Trigger full-data load as soon as the user starts interacting (search
    // open, key press, etc.) — by then the chart's already rendered and the
    // main thread has cycles to spare.
    let fullDataMerged = false;
    async function ensureFullData() {
      if (fullDataMerged) return;
      const full = await loadFullData();
      const known = new Set(data.map(d => d.id));
      for (const d of full) {
        if (known.has(d.id)) continue;
        data.push(d);
        known.add(d.id);
      }
      const fullById = new Map(full.map(d => [d.id, d]));
      for (const d of data) {
        const fd = fullById.get(d.id);
        if (!fd) continue;
        d.rels.parents = fd.rels.parents;
        d.rels.children = fd.rels.children;
        d.rels.spouses = fd.rels.spouses;
      }
      // FCP wraps the data array in a `Data` class with its own internal
      // id-keyed dictionary; the free version read state.data directly
      // each updateTree, so push-and-mutate was enough. With FCP we have
      // to call updateData() so it rebuilds its index — otherwise any
      // focusOn for a person added by the merge throws "Datum not found".
      chart.updateData(data as any);
      fullDataMerged = true;
      console.log(`[chart] full data merged (${data.length} nodes)`);
    }
    // Kick off full-data preload right after first paint, but only if the
    // browser is idle and not busy with the chart layout.
    setTimeout(() => {
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(ensureFullData, { timeout: 3000 });
      } else {
        ensureFullData();
      }
    }, 100);

    // Focus history. Each recenter (search, modal "Focus tree", shift-click,
    // family-chart's own mini-tree expand arrow, etc.) pushes the previous
    // main_id so back() can return to it. Family-chart has its own
    // main_id_history but it dedupes — going A→B→A→C leaves history without
    // a way to return to A from C without oscillating, so we keep our own.
    const backStack: string[] = [];
    const BACK_STACK_MAX = 50;
    let suppressNextPush = false;
    // Seed lastMainId from the initial render that already completed, so
    // the first focusOn after page load correctly pushes the founder onto
    // the back stack (rather than discarding it as "null"). FCP exposes
    // getMainId() on the store; fall back to the data[0] id (founder)
    // if that's somehow not set yet.
    let lastMainId: string | null =
      (chart as any).store.getMainId?.()
      ?? (chart as any).store.state.main_id
      ?? data[0]?.id
      ?? null;

    chart.setBeforeUpdate(() => {
      const currentMain = (chart as any).store.getMainId?.() ?? (chart as any).store.state.main_id;
      if (lastMainId && currentMain && lastMainId !== currentMain) {
        if (suppressNextPush) {
          suppressNextPush = false;
        } else {
          backStack.push(lastMainId);
          if (backStack.length > BACK_STACK_MAX) backStack.shift();
        }
      }
      lastMainId = currentMain;
    });

    function emitNav() {
      document.dispatchEvent(new CustomEvent('familytree:nav', {
        detail: { canGoBack: backStack.length > 0 },
      }));
    }
    // FCP's setAfterUpdate replaces the previous handler entirely, so we
    // re-install our composite (placeholder hide + nav emit).
    const prevAfter = chart.afterUpdate;
    chart.setAfterUpdate((props: any) => {
      prevAfter?.(props);
      emitNav();
    });

    // Rough heuristic for "is this focus going to be slow to render."
    // Anyone within a few hops of the founder pulls in 2k+ cards at depth 6;
    // we warn the user with a loading overlay while the layout runs so the
    // UI doesn't feel hung. Threshold tuned empirically — 500 descendants in
    // any direction reliably correlates with a >1s render on this dataset.
    const SLOW_DESCENDANT_THRESHOLD = 500;
    const byIdMap = new Map<string, Datum>();
    function rebuildByIdMap() {
      byIdMap.clear();
      for (const d of data) byIdMap.set(d.id, d);
    }
    function isLikelySlow(id: string): boolean {
      if (byIdMap.size !== data.length) rebuildByIdMap();
      const seen = new Set<string>([id]);
      const queue = [id];
      let count = 0;
      while (queue.length && count < SLOW_DESCENDANT_THRESHOLD) {
        const cur = queue.shift()!;
        const node = byIdMap.get(cur);
        if (!node) continue;
        for (const c of node.rels.children) {
          if (seen.has(c)) continue;
          seen.add(c);
          count++;
          queue.push(c);
        }
      }
      return count >= SLOW_DESCENDANT_THRESHOLD;
    }

    function showLoadingThen(applyUpdate: () => void) {
      const loader = document.getElementById('family-chart-loading');
      const wasHidden = !loader;
      if (wasHidden) {
        // Re-create a transient overlay; the bootstrap one removes itself.
        const transient = document.createElement('div');
        transient.id = 'family-chart-loading';
        transient.className = 'absolute inset-0 z-20 grid place-items-center bg-[#1e1e1e]/70 text-stone-400 backdrop-blur-sm';
        transient.innerHTML = `
          <div class="flex items-center gap-3 rounded-lg border border-stone-700 bg-stone-900/90 px-4 py-3">
            <svg class="h-5 w-5 animate-spin text-stone-400" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4z"></path>
            </svg>
            <span class="text-sm">Rendering…</span>
          </div>`;
        container.appendChild(transient);
      }
      // Paint the overlay first, then run the heavy update in the next
      // animation frame so the user sees the spinner immediately rather
      // than a frozen UI.
      requestAnimationFrame(() => requestAnimationFrame(() => {
        applyUpdate();
        document.getElementById('family-chart-loading')?.remove();
      }));
    }

    (window as any).__familytree = {
      focusOn: async (id: string, opts: { trace?: boolean } = {}) => {
        // Make sure the focus target (and its neighborhood) is loaded.
        if (!data.find(d => d.id === id) || opts.trace) {
          await ensureFullData();
        }
        const slow = !opts.trace && isLikelySlow(id);
        const apply = () => {
          if (opts.trace) {
            chart.setAncestryDepth(50);
            chart.setProgenyDepth(0);
            chart.updateMainId(id);
            chart.updateTree({ tree_position: 'fit' });
          } else {
            chart.setAncestryDepth(defaultAncestry);
            chart.setProgenyDepth(defaultProgeny);
            chart.updateMainId(id);
            chart.updateTree({ tree_position: 'main_to_middle' });
          }
        };
        if (slow) showLoadingThen(apply); else apply();
      },
      back: () => {
        if (!backStack.length) return false;
        const prev = backStack.pop()!;
        suppressNextPush = true;
        const apply = () => {
          // Always restore the default depth on back — the previous focus may
          // have been a trace mode (ancestry=50, progeny=0), which would
          // otherwise stick around and warp the parent view.
          chart.setAncestryDepth(defaultAncestry);
          chart.setProgenyDepth(defaultProgeny);
          chart.updateMainId(prev);
          chart.updateTree({ tree_position: 'main_to_middle' });
        };
        if (isLikelySlow(prev)) showLoadingThen(apply); else apply();
        return true;
      },
      canGoBack: () => backStack.length > 0,
      fit: () => chart.updateTree({ tree_position: 'fit' }),
    };

    // Backspace = go back, when no input/textarea is focused and neither
    // the search palette nor the person modal is open (so users can still
    // erase characters and close-on-Esc keeps working).
    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Backspace') return;
      const tgt = e.target as HTMLElement | null;
      if (tgt?.matches('input, textarea, select, [contenteditable="true"]')) return;
      const modal = document.getElementById('person-modal') as HTMLDialogElement | null;
      const palette = document.getElementById('search-palette') as HTMLDialogElement | null;
      const suggestion = document.getElementById('suggestion-modal') as HTMLDialogElement | null;
      if (modal?.open || palette?.open || suggestion?.open) return;
      e.preventDefault();
      (window as any).__familytree?.back();
    });

    // Re-center on the focused person if the window resizes (devtools
    // toggled, GSI iframe mounting, etc.). 'inherit' keeps the user's
    // current zoom/pan rather than rewinding it to fit — and avoids the
    // scale-to-near-zero trap that 'fit' falls into for big subtrees.
    setTimeout(() => {
      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          chart.updateTree({ tree_position: 'inherit' });
        }, 200);
      });
    }, 1000);
  }

  // Defer the heavy chart bootstrap until the browser is idle. This lets the
  // page (search bar, top bar, modal stubs) become interactive immediately,
  // even though family-chart's calculateTree() takes a couple hundred ms.
  const startBootstrap = () => {
    bootstrap().catch(err => {
      console.error('Failed to load tree', err);
      const loading = document.getElementById('family-chart-loading');
      if (loading) loading.textContent = 'Failed to load the tree. See console.';
    });
  };
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(startBootstrap, { timeout: 500 });
  } else {
    setTimeout(startBootstrap, 0);
  }
</script>

<style is:global>
  /* Dark-mode palette. FCP renames its CSS custom properties from the
     free version (`--male-color` → `--f3-male-color`, etc.), so we set
     the f3-prefixed names. The bare names are kept as a no-op safety
     net in case other styles in the bundle still reference them. */
  #family-chart {
    --f3-male-color: #2389ce;        /* blue cards */
    --f3-female-color: #e87a32;      /* orange cards */
    --f3-genderless-color: #6b7280;  /* neutral gray */
    --f3-text-primary: #ffffff;
    --f3-bg-primary: #1e1e1e;
    --f3-bg-secondary: #181818;
    --f3-bg-tertiary: #2b2b2b;

    --male-color: #2389ce;
    --female-color: #e87a32;
    --genderless-color: #6b7280;
    --text-color: #ffffff;
    --background-color: #1e1e1e;

    background:
      radial-gradient(circle at 50% 30%, rgba(35, 137, 206, 0.04), transparent 70%),
      #1e1e1e;
    width: 100%;
    height: 100%;
  }

  /* family-chart leaves the SVG sizing to CSS; force it to fill.
     The SVG is nested under a generated #f3Canvas div. */
  #family-chart #f3Canvas,
  #family-chart #f3Canvas svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #family-chart .card-rect,
  #family-chart .card_text {
    cursor: pointer;
  }

  #family-chart .card_text tspan {
    font-family: ui-sans-serif, system-ui, sans-serif;
    fill: #ffffff;
  }

  /* Slightly soften the corners to feel modern */
  #family-chart .card-body-rect,
  #family-chart rect.card-male,
  #family-chart rect.card-female {
    rx: 8;
    ry: 8;
  }

  /* HTML info-icon button — anchored to the visible `.card` rect so
     `right: 6px / top: 6px` lines up with the colored card edge, not
     the card_cont anchor point.  The card needs position: relative
     for absolute children to anchor against it. */
  #family-chart .card_cont > .card {
    position: relative;
  }
  #family-chart .card_cont .card-info-icon {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 20px;
    height: 20px;
    cursor: pointer;
    z-index: 2;
    line-height: 0;
  }
  #family-chart .card_cont .card-info-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Keep the name + lifespan clear of the info-icon. The icon lives at
     right:6px and is 20px wide, so the text area needs ≥26px of right
     padding to never overlap. We add the padding on the label wrapper
     so the icon shrinks the usable text width rather than running on
     top of long names like "William Dale DeBerry 1986 – ". */
  #family-chart .card_cont .card-label {
    padding-right: 28px;
  }

  /* Connector lines: white on dark background */
  #family-chart path.link {
    stroke: rgba(255, 255, 255, 0.55) !important;
    stroke-width: 1.5px;
  }

  /* Hover-path-to-main: the plugin adds .f3-path-to-main to every card
     and link on the chain from the hovered card to the focused person.
     FCP's bundled CSS targets `.f3 ...` which loses specificity to our
     `#family-chart`-prefixed rules above; re-state with the ID prefix
     so the highlighted links thicken and turn fully opaque.  Cards
     pick up the bundled outline already (we don't override .card-
     inner outline), but we bump it here to make the path read
     unmistakably. */
