---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

// Compute the people count at build time so the loading text is always
// accurate. Reads the same tree.json the client fetches.
const treePath = resolve(fileURLToPath(import.meta.url), '..', '..', '..', 'public', 'data', 'tree.json');
let peopleCount: string;
try {
  const tree = JSON.parse(readFileSync(treePath, 'utf-8'));
  peopleCount = (tree.meta?.totalPeople ?? tree.people?.length ?? 0).toLocaleString('en-US');
} catch {
  peopleCount = '';
}
---

<!-- The tree mounts into this container -->
<div
  id="family-chart"
  class="f3 absolute inset-0"
  style="--card-radius: 12px;"
>
  <div
    id="family-chart-loading"
    class="grid h-full place-items-center text-stone-500"
  >
    <div class="flex items-center gap-3">
      <svg class="h-5 w-5 animate-spin text-stone-400" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4z"></path>
      </svg>
      <span class="text-sm">Loading {peopleCount} people…</span>
    </div>
  </div>
</div>

<script>
  import f3 from 'family-chart';
  import 'family-chart/styles/family-chart.css';

  type Datum = {
    id: string;
    data: Record<string, any>;
    rels: { parents: string[]; spouses: string[]; children: string[] };
  };

  // Lazy-load the full dataset when the user navigates outside the initial
  // slice (founder's 4-hop neighborhood, ~840 nodes).
  let fullDataPromise: Promise<Datum[]> | null = null;
  function loadFullData(): Promise<Datum[]> {
    if (!fullDataPromise) {
      fullDataPromise = fetch('/data/tree-full.json')
        .then(r => r.json())
        .then(p => p.people as Datum[]);
    }
    return fullDataPromise;
  }

  async function bootstrap() {
    performance.mark('chart:fetch-start');
    const res = await fetch('/data/tree.json');
    const payload = await res.json();
    performance.mark('chart:fetch-end');
    // `server-serialization`: counts are precomputed at build time so we
    // don't filter all 4.9k rows on the client just to populate the top bar.
    const { totalPeople, verifiedCount, sliceSize } = payload.meta;
    const data: Datum[] = payload.people;
    console.log(`[chart] initial slice ${sliceSize ?? data.length} of ${totalPeople}`);

    // Default focused person: the founder (always p_000001 — code "0").
    // We don't need to find them since family-chart starts at data[0] by
    // default and the founder is built first in transform-data.mjs.

    const container = document.getElementById('family-chart');
    if (!container) return;

    performance.mark('chart:create-start');
    const chart = f3
      .createChart(container, data as any)
      .setTransitionTime(550)
      .setCardXSpacing(280)
      .setCardYSpacing(160)
      // Limit how many generations render at once. Without these, a focused
      // founder pulls in ~8 generations of descendants (~4,900 nodes) and the
      // layout pass takes seconds. Users can click cards to expand further.
      .setAncestryDepth(6)
      .setProgenyDepth(6)
      // Pedigree collapse: this dataset has lots of intra-family marriages
      // (first-cousin marriages, descendants of two siblings marrying each
      // other, the 122 DeBerry x 17xx Nicola lines crossing repeatedly).
      // Without this, an ancestor reached through multiple paths gets drawn
      // multiple times. Enabling the toggle puts a small button on the
      // duplicates so you can collapse them down to a single instance.
      .setDuplicateBranchToggle(true)
      .setOrientationVertical();

    const card = chart
      .setCardSvg()
      .setCardDisplay([['full name'], ['lifespan']])
      // setMiniTree renders the small expand-arrow on cards that have hidden
      // relations (children/parents past the depth limit). Without it there's
      // no way to expand a node's children inline — the only navigation is
      // click-to-recenter via the modal.
      .setMiniTree(true)
      .setCardDim({
        width: 250,
        height: 70,
        img_w: 0,
        img_h: 0,
        img_x: 0,
        img_y: 0,
        text_x: 16,
        text_y: 24,
      });

    card.setOnCardClick((e: MouseEvent, d: any) => {
      const id = d.data.id;
      // Shift-click (or alt-click) recenters the chart on this card without
      // opening the modal — a quick way to navigate. Plain click opens modal
      // as before. The small expand-arrow icon on cards (rendered by
      // family-chart when there are off-screen relations) also recenters.
      if (e.shiftKey || e.altKey) {
        const ft = (window as any).__familytree;
        if (ft) ft.focusOn(id);
        return;
      }
      window.dispatchEvent(
        new CustomEvent('familytree:open-person', { detail: { id } })
      );
    });

    // After every update: hide the loader, and hide synthetic "to_add"
    // placeholder cards that family-chart auto-creates for missing parents.
    // The Datum is on the parent .card_cont's __data__ (D3 attaches it there).
    chart.afterUpdate = () => {
      document.getElementById('family-chart-loading')?.remove();
      const svg = container.querySelector('svg');
      if (!svg) return;
      const conts = svg.querySelectorAll<SVGGElement>('g.card_cont');
      conts.forEach(cont => {
        const td: any = (cont as any).__data__;
        const datum = td?.data;
        const isPlaceholder = !!datum?.to_add;
        if (isPlaceholder) cont.style.display = 'none';
      });
    };

    performance.mark('chart:create-end');
    // Initial render — fit the tree to the container so it uses the full space
    performance.mark('chart:render-start');
    chart.updateTree({ initial: true, tree_position: 'fit' });
    performance.mark('chart:render-end');

    // Surface where time went in the console so we can profile real loads.
    queueMicrotask(() => {
      const m = (a: string, b: string) =>
        performance.measure(`${a}→${b}`, a, b).duration | 0;
      console.log(
        '[chart timings]',
        'fetch+parse', m('chart:fetch-start', 'chart:fetch-end') + 'ms,',
        'setup', m('chart:create-start', 'chart:create-end') + 'ms,',
        'initial render', m('chart:render-start', 'chart:render-end') + 'ms',
      );
    });

    // Tell the top bar how many people we have
    document.dispatchEvent(
      new CustomEvent('familytree:ready', {
        detail: { total: totalPeople, verified: verifiedCount },
      })
    );

    // Expose a way to focus on a person (used by search + modal).
    // `trace: true` lifts the ancestry depth so you can see the chain all
    // the way back to the founder, and zooms out to fit the whole chain in
    // the viewport. The defaults reset when you focus on someone else.
    const defaultAncestry = 6;
    const defaultProgeny = 6;
    // Trigger full-data load as soon as the user starts interacting (search
    // open, key press, etc.) — by then the chart's already rendered and the
    // main thread has cycles to spare.
    let fullDataMerged = false;
    async function ensureFullData() {
      if (fullDataMerged) return;
      const full = await loadFullData();
      // Replace the chart's data with the full dataset. family-chart reads
      // state.data each updateTree, so just swapping the array is enough.
      // We mutate in place rather than reassigning so existing closures keep
      // working.
      const known = new Set(data.map(d => d.id));
      for (const d of full) {
        if (known.has(d.id)) continue;
        data.push(d);
        known.add(d.id);
      }
      // Now patch the slice's rels: items in the slice had their pointers to
      // outside-the-slice nodes stripped at build time. Restore them.
      const fullById = new Map(full.map(d => [d.id, d]));
      for (const d of data) {
        const fd = fullById.get(d.id);
        if (!fd) continue;
        d.rels.parents = fd.rels.parents;
        d.rels.children = fd.rels.children;
        d.rels.spouses = fd.rels.spouses;
      }
      fullDataMerged = true;
      console.log(`[chart] full data merged (${data.length} nodes)`);
    }
    // Kick off full-data preload right after first paint, but only if the
    // browser is idle and not busy with the chart layout.
    setTimeout(() => {
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(ensureFullData, { timeout: 3000 });
      } else {
        ensureFullData();
      }
    }, 100);

    (window as any).__familytree = {
      focusOn: async (id: string, opts: { trace?: boolean } = {}) => {
        // Make sure the focus target (and its neighborhood) is loaded.
        if (!data.find(d => d.id === id)) {
          await ensureFullData();
        } else if (opts.trace) {
          // Trace mode might walk past the slice; make sure we have the whole
          // ancestry chain available before drawing.
          await ensureFullData();
        }

        if (opts.trace) {
          chart.setAncestryDepth(50);
          chart.setProgenyDepth(0);
          chart.updateMainId(id);
          chart.updateTree({ tree_position: 'fit' });
        } else {
          chart.setAncestryDepth(defaultAncestry);
          chart.setProgenyDepth(defaultProgeny);
          chart.updateMainId(id);
          chart.updateTree({ tree_position: 'main_to_middle' });
        }
      },
      fit: () => chart.updateTree({ tree_position: 'fit' }),
    };

    // Re-fit if the window resizes (e.g., devtools toggled). Defer attaching
    // the listener so the resize handler doesn't compete with initial paint.
    setTimeout(() => {
      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          chart.updateTree({ tree_position: 'fit' });
        }, 200);
      });
    }, 1000);
  }

  // Defer the heavy chart bootstrap until the browser is idle. This lets the
  // page (search bar, top bar, modal stubs) become interactive immediately,
  // even though family-chart's calculateTree() takes a couple hundred ms.
  const startBootstrap = () => {
    bootstrap().catch(err => {
      console.error('Failed to load tree', err);
      const loading = document.getElementById('family-chart-loading');
      if (loading) loading.textContent = 'Failed to load the tree. See console.';
    });
  };
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(startBootstrap, { timeout: 500 });
  } else {
    setTimeout(startBootstrap, 0);
  }
</script>

<style is:global>
  /* Dark-mode palette */
  #family-chart {
    --male-color: #2389ce;       /* blue cards */
    --female-color: #e87a32;     /* orange cards */
    --genderless-color: #6b7280; /* neutral gray */
    --text-color: #ffffff;
    --background-color: #1e1e1e;

    background:
      radial-gradient(circle at 50% 30%, rgba(35, 137, 206, 0.04), transparent 70%),
      #1e1e1e;
    width: 100%;
    height: 100%;
  }

  /* family-chart leaves the SVG sizing to CSS; force it to fill.
     The SVG is nested under a generated #f3Canvas div. */
  #family-chart #f3Canvas,
  #family-chart #f3Canvas svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #family-chart .card-rect,
  #family-chart .card_text {
    cursor: pointer;
  }

  #family-chart .card_text tspan {
    font-family: ui-sans-serif, system-ui, sans-serif;
    fill: #ffffff;
  }

  /* Slightly soften the corners to feel modern */
  #family-chart .card-body-rect,
  #family-chart rect.card-male,
  #family-chart rect.card-female {
    rx: 8;
    ry: 8;
  }

  /* Connector lines: white on dark background */
  #family-chart path.link {
    stroke: rgba(255, 255, 255, 0.55) !important;
    stroke-width: 1.5px;
  }

  /* The main person gets a stronger outline */
  #family-chart .card-main-outline {
    stroke: rgba(255, 255, 255, 0.85);
    stroke-width: 2.5px;
  }
</style>
