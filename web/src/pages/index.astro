---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Tree from '../components/Tree.astro';
import PersonModal from '../components/PersonModal.astro';
import SearchPalette from '../components/SearchPalette.astro';
---

<Layout>
  <div class="flex h-full flex-col">
    <TopBar />
    <main class="relative flex-1 overflow-hidden">
      <Tree />
    </main>
    <footer class="border-t border-stone-200 bg-white px-4 py-2 text-xs text-stone-500">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        <span>
          Compiled from seven hand-curated PDFs, eight generations deep.
        </span>
        <a
          class="rounded-md border border-stone-300 bg-white px-3 py-1.5 text-stone-700 hover:bg-stone-100"
          href="mailto:family@sudoservers.com?subject=Family%20tree%20addition"
        >
          Suggest an addition
        </a>
      </div>
    </footer>
  </div>
  <PersonModal />
  <SearchPalette />
</Layout>
