---
import Layout from '../layouts/Layout.astro';
import AuthState from '../components/AuthState.astro';
import TopBar from '../components/TopBar.astro';
import Tree from '../components/Tree.astro';
import PersonModal from '../components/PersonModal.astro';
import SearchPalette from '../components/SearchPalette.astro';
import SuggestionModal from '../components/SuggestionModal.astro';

export const prerender = true;
---

<Layout>
  <AuthState />
  <div class="flex h-full flex-col">
    <TopBar />
    <main class="relative flex-1 overflow-hidden">
      <Tree />
    </main>
    <footer class="border-t border-stone-800 bg-[#171717] px-4 py-2 text-xs text-stone-400">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        <!-- People count, moved out of the top bar to free header space.
             Hidden via inline style until the chart bootstrap dispatches
             familytree:ready (handled by the TopBar script, which still
             owns the listener since the data flows from there). -->
        <span id="stats-pill" style="display:none">
          <span id="stat-total">…</span>
        </span>
        <button
          id="suggest-addition-trigger"
          type="button"
          class="rounded-md border border-stone-700 bg-stone-800 px-3 py-1.5 text-stone-200 hover:border-stone-600 hover:bg-stone-700"
        >
          Suggest an addition
        </button>
      </div>
    </footer>
  </div>
  <PersonModal />
  <SearchPalette />
  <SuggestionModal />
</Layout>
