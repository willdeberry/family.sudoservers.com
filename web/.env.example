# Copy to .env and fill in. The Client ID is the same in client and server
# scope (Google's OAuth Client IDs are public identifiers, not secrets).
# Production values live in /etc/family-sudoservers/env on the host.

PUBLIC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# GitHub fine-grained PAT with "Issues: write" on GITHUB_REPO. Leave blank
# during local dev to put /api/submit into dry-run mode.
GITHUB_TOKEN=
GITHUB_REPO=willdeberry/family.sudoservers.com
